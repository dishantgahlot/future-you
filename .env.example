# ===========================================
# FUTURE YOU - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# ===========================================

# -------------------------------------------
# Frontend (Vite)
# -------------------------------------------
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# -------------------------------------------
# Backend (Node/Express)
# -------------------------------------------
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# -------------------------------------------
# Supabase
# -------------------------------------------
# Get these from your Supabase Dashboard > Settings > API
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key - NEVER expose to frontend!
# Get this from Supabase Dashboard > Settings > API > Service Role Key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -------------------------------------------
# Groq API (for AI predictions/insights)
# -------------------------------------------
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=mixtral-8x7b-32768

# -------------------------------------------
# Google Gemini API (for AI features: Future Letters, Weekly Insights, AI Coach)
# -------------------------------------------
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro

# -------------------------------------------
# JWT (for backend auth)
# -------------------------------------------
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# -------------------------------------------
# Optional: Email/Notification Services
# -------------------------------------------
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# FROM_EMAIL=noreply@yourdomain.com

# -------------------------------------------
# Optional: Analytics/Monitoring
# -------------------------------------------
# SENTRY_DSN=your_sentry_dsn
# POSTHOG_KEY=your_posthog_key